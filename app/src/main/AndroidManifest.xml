<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".NewsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewsAppMVVMArchitecture">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--<activity
            android:name=".ui.topheadline.TopHeadlineActivity"
            android:exported="false" />-->

        <!--<activity
            android:name=".ui.offline.OfflineTopHeadlineActivity"
            android:exported="false" />-->

        <activity
            android:name=".ui.pagination.PaginationTopHeadlineActivity"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name=".ui.sources.NewsSourcesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.news.NewsListActivity"
            android:exported="false" />


        <activity
            android:name=".ui.country.CountryListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.language.LanguageListActivity"
            android:exported="false" />

    </application>

</manifest>